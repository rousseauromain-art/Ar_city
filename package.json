{
  "name": "villes-horizon",
  "private": true,
  "description": "Tests automatiques de Villes à l'horizon (la page est servie telle quelle, sans outil de construction)",
  "scripts": {
    "lint": "eslint src tests/unit",
    "types": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test": "npm run lint && npm run types && npm run test:unit && npm run test:integration && npm run test:e2e",
    "dump:v1": "node tests/caracterisation/dump-v1.mjs",
    "serve": "node tests/helpers/server.js",
    "test:integration": "node --test \"tests/integration/*.test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "7.0.2"
  }
}
